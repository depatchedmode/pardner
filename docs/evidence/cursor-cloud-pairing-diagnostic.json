      "source": "import { createRequire } from 'node:module'\nimport { appendFileSync } from 'node:fs'\nconst root=process.env.PARDNER_PAIR_DIAG_ROOT\nconst target=process.env.PARDNER_PAIR_DIAG_OUTPUT\nconst require=createRequire(root+'/package.json')\nconst {webkit}=require('playwright')\nlet sequence=0\nfunction emit(event){appendFileSync(target,JSON.stringify({sequence:++sequence,at:Date.now(),...event})+'\\n',{mode:0o600})}\nconst path=url=>{try{return new URL(url).pathname}catch{return 'non-http'}}\nconst launch=webkit.launch.bind(webkit)\nwebkit.launch=async options=>{\n const browser=await launch(options)\n emit({source:'driver',phase:'browser-launched',version:browser.version()})\n const newContext=browser.newContext.bind(browser)\n browser.newContext=async options=>{\n  const context=await newContext(options)\n  await context.exposeBinding('__pardnerPairDiagnostic',(_source,event)=>emit({source:'page',...event}))\n  await context.addInitScript(()=>{\n   const send=(phase,data={})=>{void window.__pardnerPairDiagnostic({phase,browserAt:performance.now(),documentAt:performance.timeOrigin,...data}).catch(()=>{})}\n   const hasPair=()=>new URLSearchParams(location.hash.slice(1)).has('pair')\n   const credentialPresent=()=>{try{return Object.keys(localStorage).filter(k=>k.endsWith(':credential')).some(k=>Boolean(localStorage.getItem(k)))}catch{return null}}\n   const state=()=>({hasPair:hasPair(),credentialPresent:credentialPresent(),savedVisible:Array.from(document.querySelectorAll('.save-status')).some(e=>e.textContent==='Saved locally \u00b7 synced'),saveStatus:Array.from(document.querySelectorAll('.save-status')).map(e=>['Connecting to local service','Saving locally\u2026','Local service disconnected','Local save failed','Saved locally \u00b7 waiting for hub','Saved locally \u00b7 synced'].includes(e.textContent)?e.textContent:'other'),pairInputPresent:Boolean(document.querySelector('input[autocomplete=\"one-time-code\"]')),pairButtonDisabled:Array.from(document.querySelectorAll('button')).some(b=>b.textContent==='Connecting\u2026' && b.disabled),expiredAlertVisible:document.body?.textContent.includes('The pairing code is incorrect or expired. Generate a new code on the desktop.')??false})\n   send('document-entry',{hasPair:hasPair(),credentialPresent:credentialPresent()})\n   window.addEventListener('hashchange',()=>send('hashchange',state()))\n   const replace=history.replaceState.bind(history)\n   history.replaceState=(...args)=>{const before=hasPair();const result=replace(...args);send('replace-state',{hadPair:before,hasPair:hasPair()});return result}\n   for(const name of ['setItem','removeItem']){\n    const original=Storage.prototype[name]\n    Storage.prototype[name]=function(key,...args){const result=original.call(this,key,...args);if(String(key).endsWith(':credential'))send('credential-'+name,{credentialPresent:credentialPresent()});return result}\n   }\n   const fetcher=window.fetch.bind(window)\n   window.fetch=async (...args)=>{\n    let pathname='unknown';try{pathname=new URL(typeof args[0]==='string'?args[0]:args[0].url,location.href).pathname}catch{}\n    send('fetch-start',{pathname})\n    try{const result=await fetcher(...args);send('fetch-response',{pathname,status:result.status});return result}\n    catch(error){send('fetch-error',{pathname,errorName:error.name});throw error}\n   }\n   const Original=window.WebSocket\n   window.WebSocket=class extends Original{\n    constructor(...args){super(...args);send('ws-created');this.addEventListener('open',()=>send('ws-open'));this.addEventListener('close',event=>send('ws-close',{code:event.code}));this.addEventListener('error',()=>send('ws-error'));this.addEventListener('message',event=>{try{const m=JSON.parse(event.data);send('ws-message',{hasDoc:Boolean(m.doc),hasStatus:Boolean(m.status),savedLocally:m.status?.savedLocally??null,syncPending:m.status?.syncPending??null,storageError:Boolean(m.status?.storageError)})}catch{send('ws-non-json')}})}\n   }\n   let previous=''\n   const observe=()=>{const next=state(),key=JSON.stringify(next);if(key!==previous){previous=key;send('render-state',next)}}\n   new MutationObserver(observe).observe(document,{subtree:true,childList:true,attributes:true,characterData:true})\n   window.addEventListener('DOMContentLoaded',()=>{send('dom-content-loaded');observe()})\n   window.addEventListener('beforeunload',()=>send('before-unload',state()))\n  })\n  context.on('page',page=>{\n   let id=0;const ids=new WeakMap()\n   page.on('request',req=>{ids.set(req,++id);emit({source:'driver',phase:'request',id,method:req.method(),pathname:path(req.url())})})\n   page.on('response',res=>emit({source:'driver',phase:'response',id:ids.get(res.request()),pathname:path(res.url()),status:res.status()}))\n   page.on('requestfailed',req=>emit({source:'driver',phase:'request-failed',id:ids.get(req),pathname:path(req.url())}))\n   page.on('framenavigated',frame=>{if(frame===page.mainFrame())emit({source:'driver',phase:'navigation',pathname:path(frame.url()),hasPair:new URL(frame.url()).hash.startsWith('#pair=')})})\n   page.on('pageerror',error=>emit({source:'driver',phase:'page-error',errorName:error.name}))\n  })\n  return context\n }\n return browser\n}\n"
