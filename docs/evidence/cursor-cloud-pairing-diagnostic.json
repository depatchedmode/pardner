      "source": "import pathlib,subprocess,sys,os,json,hashlib,datetime\nroot=pathlib.Path.cwd();out=root/'output/verification/cloud-pairing-diagnostic-20261105';base=pathlib.Path((out/'baseline-path.txt').read_text())\nassert datetime.datetime.now(datetime.timezone.utc)<datetime.datetime(2026,11,5,6,10,42,tzinfo=datetime.timezone.utc)\nfor rel in ['package-lock.json','ui-prototype/package-lock.json','test/pardner-connection-ui.test.js']:\n assert (root/rel).read_bytes()==(base/rel).read_bytes(),rel\ncommands=[('baseline-build',base,['npm','run','ui:build']),('candidate-build',root,['npm','run','ui:build'])]\npattern='^recovers pairing after network failure, credential rotation, and replacement links in webkit$'\nfor name,cwd,args in commands+[(name,cwd,['node','--import',str(out/'trace.mjs'),'--test','--test-name-pattern',pattern,'test/pardner-connection-ui.test.js']) for name,cwd in [('candidate',root),('baseline',base)]]:\n env=os.environ.copy()\n if name in ['candidate','baseline']:\n  code=\"const {candidateFingerprint}=await import(process.argv[1]);const {writeFile}=await import('node:fs/promises');const c=await candidateFingerprint(process.argv[2]);await writeFile(process.argv[3],JSON.stringify(c,null,2));console.log('FINGERPRINT '+c.sha256)\"\n  subprocess.run(['node','--input-type=module','-e',code,(root/'support/acceptance/candidate.js').as_uri(),str(cwd),str(out/(name+'.before.json'))],check=True)\n  env['PARDNER_PAIR_DIAG_ROOT']=str(cwd);env['PARDNER_PAIR_DIAG_OUTPUT']=str(out/(name+'.trace.jsonl'))\n print('START '+name,flush=True)\n result=subprocess.run(['node',str(root/'scripts/verify-watchdog.js'),'--timeout','900','--log',str(out/(name+'.log')),'--record',str(out/(name+'.watchdog.json')),'--',*args],cwd=cwd,env=env)\n print('END '+name+' '+str(result.returncode),flush=True)\n if 'build' in name and result.returncode:sys.exit(result.returncode)\nprint('COMPARISON_COMPLETE',flush=True)\n"
